{
  "name": "faceai",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "frontend:dev": "npm --prefix frontend run dev",
    "backend:dev": "backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir backend",
    "dev": "concurrently \"npm run frontend:dev\" \"npm run backend:dev\"",
    "postinstall": "npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
